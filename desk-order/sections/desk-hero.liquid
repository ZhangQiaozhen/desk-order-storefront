{{ 'desk-hero.css' | asset_url | stylesheet_tag }}
{% assign hero_mat = all_products['field-felt-desk-mat'] %}
<div class="desk-hero-wrap"><section class="desk-hero">
<img src="{{ 'desk-editorial.jpg' | asset_url }}" width="1536" height="1024" alt="{{ 'desk.hero_alt' | t | escape }}" fetchpriority="high">
<div class="desk-hero-copy"><h1>{% render 'desk-copy', value: section.settings.title, plain: true %}</h1><p>{% render 'desk-copy', value: section.settings.subtitle, plain: true %}</p><a href="{{ section.settings.link | default: hero_mat.url | default: routes.all_products_collection_url }}">{{ 'desk.shop' | t | escape }}</a></div></section></div>
{% schema %}
{"name":"桌序品牌首屏","settings":[{"type":"text","id":"title","label":"主标题","default":"给桌面，留一点空间。"},{"type":"text","id":"subtitle","label":"简介","default":"一张桌垫，一个收纳盘。让每天用到的物件，各有其位。"},{"type":"url","id":"link","label":"系列链接"}],"presets":[{"name":"桌序品牌首屏"}]}
{% endschema %}
